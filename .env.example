# §14 채울 값 — 전부 선택. 미설정이어도 각 컴포넌트는 기록/해당 기능만 건너뛰고 동작한다(설계 원칙 2).

# 이벤트 원장 디렉터리 (데스크톱 기본: ~/nightcrew/ledger — 선두 ~/는 자동 확장된다)
LEDGER_DIR=

# notify 기본 채널 (Slack — v2.2 사용자 결정)
SLACK_WEBHOOK_URL=
# protected 실패의 사진 첨부용 (웹훅은 파일을 못 싣는다 — 봇 토큰 + 채널 ID 필요.
# 봇에 files:write 스코프와 해당 채널 초대가 필요. 미설정이면 사진 대신 경로 텍스트)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# notify 보조 채널 (옵션 — 설정하면 Slack과 함께 발송)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Scribe 커밋 수집 화이트리스트 (콤마 구분 절대경로, 개인 리포만 — 회사 리포 금지 §6)
REPOS=

# Sentinel 팩별 배포 URL (팩의 base_url_env가 가리키는 이름과 일치해야 함)
FAC_DEMO_BASE_URL=

# 로컬 요약 엔진 (데스크톱 Ollama)
OLLAMA_URL=http://localhost:11434

# --- 고급/선택 (미설정 시 괄호의 기본값) ---
# claude CLI 절대경로 — cron PATH에 claude가 없을 때 지정 (기본: PATH의 `claude`)
#NC_CLAUDE_BIN=
# Ollama 요약 모델 (기본: llama3)
#NC_OLLAMA_MODEL=

# --- 감시견 위성 전용 (v2.4 기기 무관 — watchdog/*.sh·deadman이 읽음, deploy/watchdog.crontab.example 참조) ---
# 데스크톱 ssh 호스트 (기본: desktop — tailnet MagicDNS 이름)
#NC_DESKTOP_HOST=
# 데스크톱의 nightcrew 경로, 원격 홈 기준 (기본: nightcrew)
#NC_DESKTOP_NIGHTCREW=
# 위성 백업 루트 (기본: ~/nightcrew-backup)
#NC_BACKUP_ROOT=
# deadman이 검사할 백업 원장 경로 (기본: ~/nightcrew-backup/ledger — NC_BACKUP_ROOT를 바꾸면 함께 변경)
#NC_BACKUP_LEDGER_DIR=
